# Never commit your real API key.
API_FOOTBALL_KEY=put-your-key-here

# Render injects this automatically when using render.yaml.
DATABASE_URL=postgresql://...

# Defaults are the two complete seasons before 2026/27.
SEASONS=2024,2025

# API-Football league IDs
LEAGUES=39:Premier League,140:La Liga,135:Serie A,78:Bundesliga,61:Ligue 1

# Bulk fixture detail batching; API-Football supports up to 20 IDs.
BATCH_SIZE=20

# Keep a safety buffer instead of consuming the final daily requests.
DAILY_REQUEST_RESERVE=20

# Optional per-fixture fallback if batched /fixtures?ids=... is missing fields.
ENABLE_FALLBACK=true
MAX_FALLBACK_REQUESTS=500

# Pull season-level /players pages too.
INCLUDE_SEASON_PLAYERS=true

# Pull /injuries (injury + suspension) per league-season, 1 call each, coverage-gated.
INCLUDE_INJURIES=true

# Only finished matches get detailed historical pulls.
ONLY_FINISHED_FOR_DETAILS=true

# Generated/set on Render for protected downloads.
DOWNLOAD_TOKEN=set-a-long-random-token

# Active-season refresh (keep false during initial/backfill runs)
REFRESH_ACTIVE_SEASON=false
ACTIVE_SEASON=2026
